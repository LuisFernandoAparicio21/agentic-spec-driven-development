{
  "name": "harness-substrate",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal generic Express + Sequelize (sqlite) app used only as a real, runnable substrate for the harness in this repo. Not a product.",
  "main": "src/bin/www.js",
  "scripts": {
    "start": "node src/bin/www.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "express-openapi-validator": "^5.3.5",
    "vitest": "^2.1.5"
  }
}
